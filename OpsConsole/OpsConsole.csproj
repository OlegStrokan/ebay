<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpsConsole</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.27.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/admin_ops.proto" GrpcServices="Client" ProtoRoot="Protos" />
    <Protobuf Include="Protos/payment_admin_ops.proto" GrpcServices="Client" ProtoRoot="Protos" />
    <Protobuf Include="Protos/inventory_admin_ops.proto" GrpcServices="Client" ProtoRoot="Protos" />
  </ItemGroup>

</Project>
